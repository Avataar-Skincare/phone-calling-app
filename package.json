{
  "name": "phone-calling-app",
  "displayName": "Compass Dialer",
  "description": "Mobile calling app for Avataar Skincare agents: Compass Smart View leads, one-tap SIM calling, call outcomes saved to Compass.",
  "version": "1.0.0",
  "private": true,
  "license": "UNLICENSED",
  "author": "Avataar Skincare",
  "repository": {
    "type": "git",
    "url": "https://github.com/Avataar-Skincare/phone-calling-app.git"
  },
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typegen": "node scripts/typegen.mjs",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "typecheck": "node scripts/typegen.mjs && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:contract": "jest --config jest.contract.config.js",
    "bundle-check": "expo export --platform android --platform ios --output-dir .expo-export-check && node -e \"require('fs').rmSync('.expo-export-check',{recursive:true,force:true})\"",
    "verify": "npm run check:lockfile && npm run lint && npm run format:check && npm run typecheck && npm test && npm run bundle-check"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.106.0",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.27",
    "expo-dev-client": "~56.0.28",
    "expo-linking": "~56.0.19",
    "expo-router": "~56.2.22",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.16",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-native/jest-preset": "0.85.3",
    "@react-native/metro-config": "0.85.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "29.5.14",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.14",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "jest": "~29.7.0",
    "jest-expo": "~56.0.6",
    "prettier": "^3.9.10",
    "react-test-renderer": "^19.2.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
