# Copy to .env for local overrides. .env is gitignored.
# EAS builds set this per profile in eas.json; you rarely need it locally.

# Compass API base URL, including /api.
#   https://compass.avataarskin.com/api (default). test-leads.avataarskin.com is the same
#   Compass (same server and database), so there is no separate testing backend.
EXPO_PUBLIC_COMPASS_API_URL=https://compass.avataarskin.com/api
