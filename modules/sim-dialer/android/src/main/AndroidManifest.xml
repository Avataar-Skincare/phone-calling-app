<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Place the call directly instead of opening the dialer pre-filled. Runtime permission. -->
  <uses-permission android:name="android.permission.CALL_PHONE" />
  <!-- Call-state events (TelephonyCallback on Android 12+) and the SIM list. Runtime permission.
       READ_CALL_LOG is deliberately NOT requested: Google Play allows it only for default dialer apps. -->
  <uses-permission android:name="android.permission.READ_PHONE_STATE" />
  <!-- Tablets without telephony can still install the app; calling is then unavailable. -->
  <uses-feature android:name="android.hardware.telephony" android:required="false" />
</manifest>
